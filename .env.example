NODE_ENV=development
PORT=3000
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Local development only. This file must stay private and never be committed.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Vercel deployment: paste the full contents of the Firebase Admin service account JSON.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# Optional: keep this only if you already use Google Application Default Credentials locally.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json